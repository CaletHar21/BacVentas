@{
    ViewData["Title"] = "Inicio";
    var nombre = User.FindFirst("NombreCompleto")?.Value;
    var esAdmin = User.IsInRole("ADMIN");
}
<h1 class="h3 mb-4">Bienvenido, @nombre</h1>

<div class="row g-3">
    @if (esAdmin)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Productos</h2>
                    <p class="text-muted">Crear, editar y eliminar productos del inventario.</p>
                    <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary">Abrir</a>
                </div>
            </div>
        </div>
    }
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Ventas</h2>
                <p class="text-muted">Registrar una nueva venta con su detalle.</p>
                <a asp-controller="Ventas" asp-action="Index" class="btn btn-outline-primary">Abrir</a>
            </div>
        </div>
    </div>
    @if (esAdmin)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Reportes</h2>
                    <p class="text-muted">Consultar ventas y exportarlas a PDF o Excel.</p>
                    <a asp-controller="Reportes" asp-action="Index" class="btn btn-outline-primary">Abrir</a>
                </div>
            </div>
        </div>
    }
</div>
